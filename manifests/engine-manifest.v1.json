        {
          "range": ">=0.156.0",
          "status": "supported"
        },
        {
          "range": ">=0.149.0 <0.156.0",
          "status": "graceful",
          "message": "Codex {version} predates the app-server protocol Sentinel targets (0.156): plan mode uses a fallback and rollback may fail. Update Codex to {recommended}."
        },
        {
          "range": "<0.149.0",
          "status": "unsupported",
          "message": "Codex {version} is older than the versions Sentinel is tested with, and some features may not work. Update Codex to {recommended}."

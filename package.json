{
  "name": "Sentinel",
  "version": "0.0.66",
  "private": true,
  "license": "Apache-2.0",
  "description": "Sentinel local-first desktop app",
  "author": "Sentinel",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.14.0 <25"
  },
  "main": "desktop/main/index.mjs",
  "scripts": {
    "preinstall": "node ./scripts/check-package-manager.mjs",
    "prepare": "lefthook install",
    "build": "node ./scripts/rebuild-node-native.mjs && node ./scripts/next-build.mjs",
    "build:desktop": "bun run build:desktop:mac",
    "build:desktop:linux": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform linux",
    "build:desktop:linux:arm64": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform linux --arch arm64",
    "build:desktop:linux:appimage": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform linux --target AppImage",
    "build:desktop:linux:deb": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform linux --target deb",
    "build:desktop:linux:rpm": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform linux --target rpm",
    "build:desktop:linux:x64": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform linux --arch x64",
    "build:desktop:mac": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform mac --target dmg,zip --arch arm64",
    "build:desktop:mac:arm64": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform mac --target dmg,zip --arch arm64",
    "build:desktop:mac:x64": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform mac --target dmg,zip --arch x64",
    "build:desktop:prepare": "bun run ./scripts/desktop/clean.mjs && bun run ./scripts/desktop/normalize-node-module-manifests.mjs && bun run build && bun run ./scripts/desktop/prepare-production.mjs && bun run ./scripts/desktop/prune-server.mjs && bun run ./scripts/desktop/prepare-shell.mjs",
    "build:desktop:windows": "bun run build:desktop:prepare && node ./scripts/desktop/package.mjs --platform win --target nsis",
    "electron:install": "node ./scripts/desktop/electron-binary.mjs",
    "audit:desktop-bundle": "node ./scripts/desktop/audit-bundle.mjs",
    "dev:desktop": "node ./scripts/rebuild-node-native.mjs && concurrently -k \"next dev --port 3232\" \"bun run ./scripts/desktop/dev-launch.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "node -e \"require('esbuild-register'); require('./scripts/db/push.ts')\"",
    "db:generate": "bun x drizzle-kit generate",
    "db:studio": "bun x drizzle-kit studio",
    "dev": "node ./scripts/rebuild-node-native.mjs && next dev",
    "preview": "node ./scripts/rebuild-node-native.mjs && node ./scripts/next-build.mjs && next start",
    "release:version:check": "node ./scripts/release/validate-release-version.mjs",
    "start": "node ./scripts/rebuild-node-native.mjs && next start",
    "test": "node ./scripts/run-tests.mjs",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@ai-sdk/amazon-bedrock": "^5.0.108",
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/azure": "^4.0.94",
    "@ai-sdk/black-forest-labs": "^2.0.57",
    "@ai-sdk/bytedance": "^2.0.59",
    "@ai-sdk/cohere": "^4.0.57",
    "@ai-sdk/deepseek": "^3.0.61",
    "@ai-sdk/fal": "^3.0.57",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/google-vertex": "^5.0.104",
    "@ai-sdk/groq": "^4.0.57",
    "@ai-sdk/klingai": "^4.0.58",
    "@ai-sdk/mcp": "^2.0.69",
    "@ai-sdk/mistral": "^4.0.59",
    "@ai-sdk/moonshotai": "^3.0.65",
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/provider": "^4.0.24",
    "@ai-sdk/provider-utils": "^5.0.56",
    "@ai-sdk/react": "^4.0.133",
    "@ai-sdk/replicate": "^3.0.57",
    "@ai-sdk/xai": "^5.0.17",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@github/copilot-sdk": "^1.0.16",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@iconify/react": "^6.0.2",
    "@internationalized/date": "^3.12.4",
    "@linear/sdk": "^97.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@notionhq/client": "^5.27.0",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.18.35",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pierre/diffs": "^1.5.2",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@slack/web-api": "^8.2.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/turndown": "^5.0.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.130",
    "better-sqlite3": "13.0.3",
    "border-beam": "^1.4.1",
    "cmdk": "^1.1.1",
    "cronbake": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "electron-updater": "^6.8.9",
    "googleapis": "^183.0.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "motion": "^14.0.0",
    "mysql2": "^3.24.5",
    "next": "^16.4.0",
    "node-pptx-parser": "^1.0.1",
    "node-pty": "^1.1.0",
    "node-xlsx": "^0.24.0",
    "officeparser": "^6.1.1",
    "pg": "^8.23.1",
    "ppt": "^0.0.2",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-video-kit": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "resumable-stream": "^2.2.13",
    "rtf2text": "^1.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "sileo": "^0.1.5",
    "sqlite-vec": "^0.1.9",
    "superjson": "^2.2.6",
    "turndown": "^7.2.4",
    "undici": "^7.30.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "lefthook": "^2.1.17",
    "lint-staged": "^17.6.0",
    "node-gyp": "^12.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wait-on": "^9.5.1"
  },
  "trustedDependencies": [
    "electron-winstaller",
    "esbuild",
    "lefthook",
    "node-pty",
    "sharp"
  ],
  "build": {
    "appId": "app.sentinel.desktop",
    "afterPack": "scripts/desktop/after-pack.cjs",
    "beforeBuild": "scripts/desktop/before-build.cjs",
    "directories": {
      "app": "dist/desktop-app",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "desktop/dist/server",
        "to": "server"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "desktop/helpers/**/*"
    ],
    "files": [
      "desktop/helpers/**/*",
      "desktop/main/**/*",
      "desktop/preload/**/*",
      "desktop/shared/**/*",
      "scripts/desktop/constants.mjs",
      "scripts/desktop/server-manager.mjs",
      "scripts/desktop/service-manager.mjs",
      "scripts/desktop/state.mjs",
      "package.json",
      "!**/node_modules",
      "!**/node_modules/**/*",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/*.map"
    ],
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sentinel uses the microphone to record voice prompts and transcribe them into the composer."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "executableArgs": [
        "--no-sandbox"
      ],
      "maintainer": "Mohamed Achaq <achaq@galvn.com>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "publish": [
      {
        "owner": "Cronacl",
        "provider": "github",
        "repo": "Sentinel"
      }
    ]
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}

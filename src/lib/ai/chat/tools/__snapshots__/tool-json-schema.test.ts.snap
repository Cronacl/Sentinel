        "description": "Optional file glob to include in the search, for example "*.ts" or "*.{ts,tsx}".",
        "minLength": 1,
        "type": "string",
      },
      "path": {
        "description": "Directory path to search. In default permissions mode this must be relative to the selected workspace root.",
        "minLength": 1,
        "type": "string",
      },
      "pattern": {
        "description": "Regular expression pattern to search for in file contents.",
        "maxLength": 500,
        "minLength": 1,

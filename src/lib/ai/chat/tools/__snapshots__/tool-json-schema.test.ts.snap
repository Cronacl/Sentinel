        "minLength": 1,
        "type": "string",
      },
      "planId": {
        "minLength": 1,
        "type": "string",
      },
      "summary": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string",
      },
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
    },
    "type": "object",
  },
}

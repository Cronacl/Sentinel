              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "durationMs": {
                  "maximum": 2000,
                  "minimum": 0,
                  "type": "integer",
                },
                "modifiers": {
                  "items": {
                    "enum": [
                      "command",
                      "control",
                      "option",
                      "shift",
                    ],
                    "type": "string",
                  },
                  "maxItems": 4,
                  "type": "array",
                },
                "type": {

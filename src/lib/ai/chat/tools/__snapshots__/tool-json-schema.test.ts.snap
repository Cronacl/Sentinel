        "type": "array",
      },
      "limit": {
        "default": 50,
        "maximum": 200,
        "minimum": 1,
        "type": "integer",
      },
      "tabId": {
        "description": "Optional browser tab id. Defaults to the active browser tab.",
        "minLength": 1,

    },
    "required": [
      "path",
    ],
    "type": "object",
  },
  "update_plan": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "audience": {
        "enum": [
          "technical",
          "general",
        ],
        "type": "string",
      },
      "document": {
        "maxLength": 40000,
        "minLength": 1,

      },
      "tabId": {
        "description": "Optional browser tab id. Defaults to the active browser tab.",
        "minLength": 1,
        "type": "string",
      },
      "x": {
        "description": "Viewport x coordinate.",
        "type": "number",
      },
      "y": {
        "description": "Viewport y coordinate.",
        "type": "number",
      },
    },
    "type": "object",
  },
  "browser_console_logs": {
    "$schema": "http://json-schema.org/draft-07/schema#",

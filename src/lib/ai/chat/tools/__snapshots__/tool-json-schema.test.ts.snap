        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer",
      },
      "size": {
        "description": "Optional size like 1024x1024.",
        "pattern": "^\\d+x\\d+$",
        "type": "string",
      },
    },
    "required": [
      "prompt",
    ],
    "type": "object",
  },

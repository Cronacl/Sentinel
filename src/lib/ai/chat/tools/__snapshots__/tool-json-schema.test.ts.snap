                "y",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "button": {
                  "default": "left",
                  "enum": [
                    "left",
                    "right",
                    "middle",
                  ],
                  "type": "string",
                },
                "clickCount": {
                  "default": 1,
                  "maximum": 3,
                  "minimum": 1,
                  "type": "integer",
                },
                "modifiers": {
                  "items": {
                    "enum": [
                      "command",
                      "control",
                      "option",
                      "shift",
                    ],
                    "type": "string",
                  },
                  "maxItems": 4,

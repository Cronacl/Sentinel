      },
      "count": {
        "default": 1,
        "description": "Number of images to generate per provider.",
        "maximum": 4,
        "minimum": 1,
        "type": "integer",
      },
      "mode": {
        "default": "single",
        "description": "Use single for one provider or multi_model to fan out.",
        "enum": [
          "single",
          "multi_model",
        ],
        "type": "string",
      },
      "modelId": {
        "description": "Optional model override for single-provider generation.",
        "minLength": 1,
        "type": "string",
      },
      "prompt": {
        "description": "Describe the image you want to generate.",
        "minLength": 1,
        "type": "string",
      },

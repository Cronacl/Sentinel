// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`tool input JSON schemas converts every built-in chat tool to a valid object schema 1`] = `
{
  "apply_patch": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "patchText": {
        "minLength": 1,
        "type": "string",
      },
      "rationale": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "patchText",
      "rationale",
    ],
    "type": "object",
  },
  "batch_read": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "maximum": 400,
        "minimum": 1,
        "type": "integer",
      },
      "offset": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer",
      },
      "paths": {
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 25,
        "minItems": 1,
        "type": "array",
      },
    },
    "required": [
      "paths",
    ],
    "type": "object",
  },
  "browser_back": {
    "$schema": "http://json-schema.org/draft-07/schema#",

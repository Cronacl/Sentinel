        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "name",
    ],
    "type": "object",
  },
  "manage_task": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "action": {
        "description": "Required. The action to perform: 'create' a new task, 'update' an existing task's status/title/description, or 'delete' a task.",
        "enum": [
          "create",
          "update",
          "delete",
        ],
        "type": "string",
      },
      "description": {
        "anyOf": [
          {
            "maxLength": 600,
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
        "description": "Optional task description.",
      },
      "planId": {
        "description": "Optional plan ID. Omit to use the current thread plan.",
        "minLength": 1,
        "type": "string",
      },
      "status": {
        "description": "Task status: 'pending', 'in_progress', 'completed', or 'blocked'. Required for update actions.",
        "enum": [
          "pending",
          "in_progress",
          "completed",
          "blocked",
        ],
        "type": "string",
      },
      "taskId": {
        "description": "Required for update and delete actions. The ID of the task to modify.",
        "minLength": 1,
        "type": "string",
      },
      "title": {
        "description": "Task title. Required for create actions.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "action",
    ],
    "type": "object",
  },
  "move_file": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "fromPath": {
        "minLength": 1,
        "type": "string",
      },
      "rationale": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string",
      },
      "toPath": {
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "fromPath",
      "rationale",
      "toPath",
    ],
    "type": "object",
  },
  "multiedit": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "edits": {
        "description": "Ordered exact-text edits to apply to the same file.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "newString": {
              "description": "Replacement text.",
              "type": "string",
            },
            "oldString": {
              "description": "Exact text to replace.",
              "minLength": 1,
              "type": "string",
            },
            "replaceAll": {
              "description": "Replace every occurrence for this edit instead of exactly one.",
              "type": "boolean",
            },
          },
          "required": [
            "newString",
            "oldString",
          ],
          "type": "object",
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
      },
      "path": {
        "description": "File path to modify. In default permissions mode this must be relative to the selected workspace root.",
        "minLength": 1,
        "type": "string",
      },
      "rationale": {
        "description": "Why these coordinated edits are needed.",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "edits",
      "path",
      "rationale",
    ],
    "type": "object",
  },
  "read": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "maximum": 400,
        "minimum": 1,
        "type": "integer",
      },
      "offset": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer",
      },
      "path": {
        "description": "File or directory path to read. In default permissions mode this must be relative to the selected workspace root.",
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "path",
    ],
    "type": "object",
  },
  "run_subagent": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "allowMutations": {
        "default": true,
        "type": "boolean",
      },
      "prompt": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string",
      },
      "toolHints": {
        "additionalProperties": false,
        "properties": {
          "categories": {
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 8,
            "type": "array",
          },
          "integrationNamespaces": {
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 8,
            "type": "array",
          },
          "mcpNamespaces": {
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 8,
            "type": "array",
          },
          "note": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "virtualKey": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "prompt",
    ],
    "type": "object",
  },
  "run_task": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "path": {
        "description": "Directory path to run the task from. In default permissions mode this must be relative to the selected workspace root.",
        "minLength": 1,
        "type": "string",
      },
      "rationale": {
        "description": "Why this project task should run.",
        "minLength": 1,
        "type": "string",
      },
      "task": {
        "description": "Project task to run using the nearest package.json script.",
        "enum": [
          "build",
          "format",
          "lint",
          "test",
          "typecheck",
        ],
        "type": "string",
      },
    },
    "required": [
      "rationale",
      "task",
    ],
    "type": "object",
  },
  "save_memory": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "content": {
        "description": "Durable information worth keeping for future conversations.",
        "maxLength": 8000,
        "minLength": 8,
        "type": "string",
      },
      "kind": {
        "description": "The kind of memory being stored.",
        "enum": [
          "preference",
          "profile",
          "workflow",
          "project",
          "fact",
        ],
        "type": "string",
      },
      "salience": {
        "description": "How important this memory is for future recall.",
        "maximum": 1,
        "minimum": 0,
        "type": "number",
      },
      "scope": {
        "description": "Store as global memory or attach it to the active workspace.",
        "enum": [
          "global",
          "workspace",
          "auto",
        ],
        "type": "string",
      },
      "summary": {
        "description": "Compact memory summary for prompt injection.",
        "maxLength": 160,
        "type": "string",
      },
    },
    "required": [
      "content",
      "kind",
    ],
    "type": "object",
  },
  "search_memory": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "Maximum number of memories to return.",
        "maximum": 12,
        "minimum": 1,
        "type": "integer",
      },
      "query": {
        "description": "What to look up in long-term memory.",
        "minLength": 1,
        "type": "string",
      },
      "scope": {
        "description": "Search global memory, workspace memory, or both.",
        "enum": [
          "auto",
          "both",
          "global",
          "workspace",
        ],
        "type": "string",
      },
    },
    "required": [
      "query",
    ],
    "type": "object",
  },
  "shell_command": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "backgroundTaskId": {
        "description": "Background task id returned by start_background. Required for check_background and stop_background.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "command": {
        "description": "One shell command to run in the linked workspace root or discovered skill directory. Required for run and start_background modes.",
        "maxLength": 2000,
        "minLength": 1,
        "type": "string",
      },
      "mode": {
        "description": "How to use the shell. Use run for normal foreground commands, start_background for long-running commands, check_background to poll a background task, and stop_background to stop one.",
        "enum": [
          "run",
          "start_background",
          "check_background",
          "stop_background",
        ],
        "type": "string",
      },
      "rationale": {
        "description": "Why this command is needed and what you expect to learn.",
        "maxLength": 500,
        "minLength": 1,
        "type": "string",
      },
      "runInBackground": {
        "description": "Convenience flag equivalent to mode=start_background when true.",
        "type": "boolean",
      },
      "waitForCompletion": {
        "description": "For check_background, wait until the background command completes instead of returning the current snapshot.",
        "type": "boolean",
      },
    },
    "required": [
      "rationale",
    ],
    "type": "object",
  },
  "webfetch": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "format": {
        "default": "markdown",
        "description": "The response format to return. Prefer markdown for documentation pages unless plain text or raw HTML is specifically needed.",
        "enum": [
          "text",
          "markdown",
          "html",
        ],
        "type": "string",
      },
      "timeout": {
        "description": "Optional timeout in seconds, up to 120.",
        "maximum": 120,
        "minimum": 1,
        "type": "integer",
      },
      "url": {
        "description": "A single URL to fetch.",
        "minLength": 1,
        "type": "string",
      },
      "urls": {
        "description": "Optional batch of URLs to fetch when batch mode is enabled in General settings.",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 50,
        "minItems": 1,
        "type": "array",
      },
    },
    "type": "object",
  },
  "websearch": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "livecrawl": {
        "enum": [
          "never",
          "preferred",
          "always",
        ],
        "type": "string",
      },
      "provider": {
        "enum": [
          "exa",
          "searxng",
        ],
        "type": "string",
      },
      "query": {
        "description": "Search query to run on the web.",
        "minLength": 1,
        "type": "string",
      },
      "resultCount": {
        "description": "Maximum number of search results to return.",
        "maximum": 25,
        "minimum": 1,
        "type": "integer",
      },
      "searchType": {
        "description": "Search depth and speed mode.",
        "enum": [
          "auto",
          "fast",
          "deep",
        ],
        "type": "string",
      },
    },
    "required": [
      "query",
    ],
    "type": "object",
  },
}
`;

exports[`tool input JSON schemas converts every plan-mode tool to a valid object schema 1`] = `
{
  "ask_question": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "questions": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "allowMultiple": {
              "description": "When true the user can select multiple options instead of one. Use for questions where several answers apply simultaneously.",
              "type": "boolean",
            },
            "header": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string",
            },
            "id": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string",
            },
            "options": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "maxLength": 400,
                    "minLength": 1,
                    "type": "string",
                  },
                  "label": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "description",
                  "label",
                ],
                "type": "object",
              },
              "maxItems": 8,
              "minItems": 2,
              "type": "array",
            },
            "question": {
              "maxLength": 400,
              "minLength": 1,

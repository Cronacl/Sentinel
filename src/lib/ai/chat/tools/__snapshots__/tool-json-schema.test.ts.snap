      "ignore": {
        "description": "Optional path prefixes, names, or simple glob patterns to exclude from the listing.",
        "items": {
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 32,
        "type": "array",
      },
      "maxDepth": {
        "description": "Maximum directory depth to recurse into. Defaults to 12 levels.",
        "maximum": 64,
        "minimum": 0,
        "type": "integer",
      },
      "path": {
        "description": "Directory path to inspect. In default permissions mode this must be relative to the selected workspace root.",
        "minLength": 1,
        "type": "string",
      },
    },
    "type": "object",
  },
  "load_document": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "attachmentIndex": {
        "description": "1-based index used to disambiguate duplicate filenames on the same message.",
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer",
      },
      "filename": {
        "description": "Filename of the attachment to load when source is message_attachment.",
        "minLength": 1,
        "type": "string",
      },
      "maxChars": {
        "description": "Optional maximum character count for normalized output.",
        "maximum": 120000,
        "minimum": 1,
        "type": "integer",
      },
      "messageId": {
        "description": "Optional source message id. Defaults to the current source message when loading attachments.",
        "minLength": 1,
        "type": "string",
      },
      "path": {
        "description": "Workspace file path to load when source is workspace_path. In default permissions mode this must stay inside the selected workspace root or discovered skill directories.",
        "minLength": 1,
        "type": "string",
      },
      "source": {
        "enum": [
          "workspace_path",
          "message_attachment",
